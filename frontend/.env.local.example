# TrustMesh frontend.
#
# Copy this to frontend/.env.local and adjust. Points the frontend at the
# backend — the Fabric backend (`npm run dev:fabric`, defaults to :4000) by
# default, or the EVM fallback backend (`npm run dev`, also :4000) if that's
# what you're running instead. Either way there is only one variable: the
# frontend never talks to the chain/ledger or holds any chain RPC config
# directly, only to the backend.

NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
