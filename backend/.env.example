# TrustMesh backend — EVM/Solidity fallback stack (`npm run dev`, src/server.ts).
#
# This is the ORIGINAL stack, intentionally preserved alongside the current
# Hyperledger Fabric stack (see backend/.env.fabric.example, `npm run
# dev:fabric`, src/server.fabric.ts) rather than removed. If you're setting up
# the Fabric stack — the one the rest of the project currently runs against —
# use backend/.env.fabric.example instead of this file.
#
# Copy this to backend/.env and adjust to run the EVM stack.

PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# --- Postgres (shared schema — same DB works for either stack) ---------------
DATABASE_URL=postgres://localhost:5432/trustmesh

# --- Polygon Amoy testnet (or a local Hardhat node) ---------------------------
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
# Deployer/relayer key. Never a real funded key in this file — generate a
# throwaway testnet key for local dev.
CHAIN_PRIVATE_KEY=

# Contract addresses from `npx hardhat run scripts/deploy.ts` in contracts/.
DID_REGISTRY_ADDRESS=
REVOCATION_REGISTRY_ADDRESS=
ACCESS_CONTROL_REGISTRY_ADDRESS=
ASSET_NFT_ADDRESS=
GNOSIS_SAFE_ADDRESS=

# Local-demo-only: bypasses the hosted Safe Transaction Service (which cannot
# see a local Hardhat chain) and executes the Safe's 2-of-3 approval directly
# on-chain using the two owner keys below. Never set this against a real
# network.
SAFE_LOCAL_MODE=false
LOCAL_SAFE_OWNER1_KEY=
LOCAL_SAFE_OWNER2_KEY=

# --- Private, self-hosted IPFS (Stage 1 P3.1 — Kubo, not Pinata) -------------
IPFS_API_URL=http://127.0.0.1:5001

# --- Keys ----------------------------------------------------------------------
# PII vault encryption key (DPDP "erasure" = deleting the row this key
# decrypts). 32 bytes, hex-encoded. Generate with: openssl rand -hex 32
PII_VAULT_MASTER_KEY=

# Session-cookie signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=dev-only-insecure-secret-change-me
