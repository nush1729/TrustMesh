# TrustMesh backend — Hyperledger Fabric environment (§2 of the migration proposal).
# This is the CURRENT stack (`npm run dev:fabric`, src/server.fabric.ts) — use
# this file unless you specifically need the preserved EVM/Solidity fallback
# stack (`npm run dev`, src/server.ts), which reads backend/.env.example
# instead. The two are separate stacks with separate variable sets, not two
# copies of the same thing — don't merge them.
#
# Copy to backend/.env and adjust. Every EVM variable (AMOY_RPC_URL, CHAIN_ID,
# CHAIN_PRIVATE_KEY, GNOSIS_SAFE_ADDRESS, SAFE_LOCAL_MODE, LOCAL_SAFE_OWNER*_KEY,
# PINATA_JWT, *_ADDRESS) is obsolete on this stack.

PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# --- Postgres (schema unchanged by this migration) ---------------------------
DATABASE_URL=postgres://localhost:5432/trustmesh

# --- Fabric network ----------------------------------------------------------
# Where the fabric-samples test-network lives; must match fabric/network-env.sh.
FABRIC_TEST_NETWORK_PATH=/Users/you/fabric/fabric-samples/test-network
FABRIC_CHANNEL_NAME=trustmesh
FABRIC_CHAINCODE_NAME=trustmesh

# Which organization this backend proposes as. org1=IssuingDept,
# org2=AuditOrg, org3=IndependentVerifier.
FABRIC_PRIMARY_ORG=org1

# Optional peer endpoint overrides (defaults are the test-network's localhost ports).
# FABRIC_ORG1_PEER_ENDPOINT=localhost:7051
# FABRIC_ORG2_PEER_ENDPOINT=localhost:9051
# FABRIC_ORG3_PEER_ENDPOINT=localhost:11051

# Durable checkpoint for the event indexer (§9). Delete it to re-index from
# block 0; keep it to resume exactly where the indexer left off.
FABRIC_CHECKPOINT_FILE=./.fabric-checkpoint.json

# --- Private, self-hosted IPFS (Stage 1 P3.1, unchanged by this migration) ----
IPFS_API_URL=http://127.0.0.1:5001

# --- Keys --------------------------------------------------------------------
# secp256k1 key the backend issues Verifiable Credentials with; its did:key is
# the issuer DID. In production this comes from the secrets/KMS service the
# Final Solution §7 requires — never from this file.
VC_ISSUER_PRIVATE_KEY=

PII_VAULT_MASTER_KEY=
SESSION_SECRET=
