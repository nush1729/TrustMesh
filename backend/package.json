{
  "name": "trustmesh-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:fabric": "vitest run --config vitest.fabric.config.ts",
    "dev:fabric": "tsx watch src/server.fabric.ts",
    "start:fabric": "node dist/server.fabric.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@hyperledger/fabric-gateway": "^1.12.1",
    "@safe-global/api-kit": "^2.5.6",
    "@safe-global/protocol-kit": "^4.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "did-jwt": "^8.0.4",
    "did-jwt-vc": "^4.0.4",
    "did-resolver": "^5.0.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "ethr-did-resolver": "^11.0.3",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.1",
    "pg": "^8.13.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
