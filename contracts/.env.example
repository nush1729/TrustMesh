# TrustMesh contracts — Hardhat env for the preserved EVM/Solidity fallback
# stack. Only needed if you're deploying or interacting with the Polygon Amoy
# contracts (backend/.env.example, not backend/.env.fabric.example, is the
# matching backend config).
#
# Copy this to contracts/.env and adjust.

# Polygon Amoy testnet RPC endpoint (or a local Hardhat node URL for `npx hardhat node`).
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Deployer key for `npm run deploy:amoy`. Use a throwaway testnet key funded
# with Amoy test MATIC from a faucet — never a real, funded private key.
DEPLOYER_PRIVATE_KEY=

# The address backend/.env's CHAIN_PRIVATE_KEY corresponds to — needed by
# scripts/configureSafe.ts to wire that relayer address into the deployed
# Safe/registries after `npm run deploy:amoy`.
BACKEND_RELAYER_ADDRESS=
